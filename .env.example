# ═══════════════════════════════════════════════════════════════════════════════
# NanoBrowser — Extension / Frontend Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API Base URL (defaults to production URL if omitted)
VITE_BACKEND_API_URL=http://localhost:5000

# PostHog Analytics
VITE_POSTHOG_API_KEY=your-posthog-api-key-here
# VITE_POSTHOG_HOST=https://app.posthog.com

# Google OAuth Client ID — SAFE to expose in the extension build
VITE_GOOGLE_CLIENT_ID=336340854879-i6hj15oe17se379u6k377slo7pvbvh3v.apps.googleusercontent.com

# Firebase Web API Key — PUBLIC, used by extension to refresh ID tokens directly
# Get from: Firebase Console → Project Settings → General → Web API key
VITE_FIREBASE_API_KEY=your-firebase-web-api-key-here