{
  "name": "@nanobrowser/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API service for NanoBrowser commercial SaaS",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prettier": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "5.5.4",
    "vitest": "^2.1.1"
  }
}
