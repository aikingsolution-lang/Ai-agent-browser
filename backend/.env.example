# ═══════════════════════════════════════════════════════════════════════════════
# NanoBrowser Backend — Server Environment Variables
# Copy to backend/.env and fill in your values.
# ⚠ NEVER commit this file or expose Firebase Admin credentials to the client.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,chrome-extension://*
LOG_LEVEL=info

# ── Firebase Admin SDK + Realtime Database (SERVER-ONLY) ──────────────────────
# The backend stores all data in the JobForm Automator Firebase Realtime Database, under the
# NANOBROWSER_RTDB_ROOT namespace. Variable names match JobForm Automator's lib/firebase-admin.ts,
# so the same service-account values can be reused.
# ⚠ These credentials are SECRET — never expose them to the browser or extension build.
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full PEM key on one line with literal \n, or wrap it in double quotes.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
# Realtime Database URL (Firebase Console → Realtime Database). NEXT_PUBLIC_FIREBASE_DATABASE_URL is also accepted.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Root node for every NanoBrowser path (keeps the data apart from JobForm Automator's own nodes).
NANOBROWSER_RTDB_ROOT=nanobrowser
# PUBLIC Firebase Web API key of the same project (JobForm Automator's NEXT_PUBLIC_FIREBASE_API_KEY).
# Used by POST /auth/login (email sign-in) and POST /auth/refresh (ID-token refresh fallback);
# both return 501 when it is not set.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ── One-off MongoDB → RTDB migration only (not used by the running server) ────
# Read-only connection string for src/scripts/migrate-mongo-to-rtdb (see docs/FIREBASE_RTDB_MIGRATION.md).
# MIGRATION_MONGO_URI=mongodb+srv://readonly-user:password@cluster.example.mongodb.net/nanobrowser_saas

# ── Razorpay (SERVER-ONLY) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Razorpay subscription plan IDs (create in Razorpay dashboard → Subscriptions → Plans)
RAZORPAY_PLAN_ID_STARTER=plan_xxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_POWER=plan_xxxxxxxxxxxxxxxx

# ── LLM Providers (SERVER-ONLY) ───────────────────────────────────────────────
AWS_BEDROCK_API_KEY=your_bedrock_bearer_token_here
AWS_BEDROCK_REGION=us-east-1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_DEFAULT_MODEL=amazon.nova-lite-v1:0

# ── Google OAuth (client ID is safe to expose) ────────────────────────────────
GOOGLE_CLIENT_ID=336340854879-i6hj15oe17se379u6k377slo7pvbvh3v.apps.googleusercontent.com
