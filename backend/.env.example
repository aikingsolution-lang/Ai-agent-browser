# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,chrome-extension://*

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/nanobrowser_saas

# Logger Configuration
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_must_be_changed_in_production_min_32_chars
JWT_EXPIRES_IN=15m

# Commercial Payment (Razorpay) Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Managed LLM Gateway Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_DEFAULT_MODEL=gpt-4o-mini
