# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,chrome-extension://*

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/nanobrowser_saas

# Logger Configuration
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_must_be_changed_in_production_min_32_chars
JWT_EXPIRES_IN=15m

# Commercial Payment (Razorpay) Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Managed LLM Gateway Configuration (AWS Bedrock Runtime Bearer Token)
AWS_BEDROCK_API_KEY=your_bedrock_bearer_token_here
AWS_BEDROCK_REGION=us-east-1
LLM_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
